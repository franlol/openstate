{
  "name": "openstate",
  "version": "0.1.4",
  "description": "A terminal UI to inspect and time-travel app state, Redux DevTools compatible",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franlol/openstate.git"
  },
  "homepage": "https://github.com/franlol/openstate",
  "type": "module",
  "private": true,
  "bin": {
    "openstate": "src/main.tsx"
  },
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "bun": "./client/index.ts",
      "default": "./dist/client/index.js"
    }
  },
  "scripts": {
    "dev": "bun --watch src/main.tsx",
    "start": "NODE_ENV=production bun src/main.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build client/index.ts --outdir dist/client --packages external --env disable && tsc -p tsconfig.client.json",
    "demo": "NODE_ENV=production bun src/main.tsx --demo",
    "release": "NODE_ENV=production bun scripts/release.ts"
  },
  "dependencies": {
    "@opentui/core": "^0.8.2",
    "@opentui/keymap": "^0.8.2",
    "@opentui/react": "^0.8.2",
    "@redux-devtools/instrument": "^3.0.0",
    "diff": "^9.0.0",
    "jsan": "^3.1.14",
    "react": "^19.3.1"
  },
  "peerDependencies": {
    "redux": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "redux": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/jsan": "^3.1.5",
    "@types/react": "^19.3.0",
    "redux": "^5.0.1",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "client",
    "dist"
  ]
}
